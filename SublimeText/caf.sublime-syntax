%YAML 1.2
---

name: CRC Assembly Format
file_extensions:
  - caf
scope: source.crc-ir
contexts:
  comment:
    - match: \|.*$
      scope: comment.line.crc-ir

  main:
    - include: variable
    - include: comment

    # instructions operands
    - match: (@)(in|out|tmp|imm|regb)(\[)
      captures:
        1: entity.name.function.crc-ir
        2: support.function.crc-ir
        3: meta.brackets.crc-ir
      push: runtime_arg

    - match: (@)(reg)(\[)
      captures:
        1: entity.name.function.crc-ir
        2: support.function.crc-ir
        3: meta.brackets.crc-ir
      push: reg_arg

    # instruction mnemonics
    - match: (@)(mov|mvz|add|sub|and|xor|orr|sh[lr]|ldb|stb|jiz|jmp|ret)(?!@)\b
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir

    - match: (@)(deflabel|function)(\[)
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
        3: meta.brackets.crc-ir
      push: decl_arg

    - match: (@)(label)(\[)
      captures:
        1: entity.name.function.crc-ir
        2: support.function.crc-ir
        3: meta.brackets.crc-ir
      push: decl_arg

    - match: (@)(raw)(\[)(.+?)(\])
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
        3: meta.brackets.crc-ir
        4: string.unquoted.crc-ir
        5: meta.brackets.crc-ir

    # preprocessor
    - match: (%)(raw)(\[)
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
        3: meta.brackets.crc-ir
      push: raw_block

    - match: (%)(unset)(\[)
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
        3: meta.brackets.crc-ir
      push: pp_arg

    - match: (%)(log|fatal|include)(\[)
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
        3: meta.brackets.crc-ir
      push: pp_arg_longest

    - match: (%)(set(?:eval)?|macro)(\[)
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
        3: meta.brackets.crc-ir
      push: [pp_arg_longest, bracket, pp_arg_nolist]

    - match: (%)(pop|shift)(\[)
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
        3: meta.brackets.crc-ir
      push: [pp_arg_nolist, pp_arg_nolist]

    - match: (%)(len)(\[)
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
        3: meta.brackets.crc-ir
      push: [pp_arg, pp_arg_nolist]

    - match: (%)(repl)(\[)
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
        3: meta.brackets.crc-ir
      push: [pp_arg, pp_arg, pp_arg, pp_arg_nolist]

    - match: (%)(index|substr)(\[)
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
        3: meta.brackets.crc-ir
      push: [pp_arg, pp_arg, pp_arg_nolist]

    - match: (%)(if\d*)(\[)
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
        3: meta.brackets.crc-ir
      push: [if_body, if_then, pp_arg, pp_arg, pp_arg_nolist]

    - match: (%)(loop\d*)
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
      push: loop_body

    - match: (%)(foreach\d*)(\[)
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
        3: meta.brackets.crc-ir
      push: [foreach_body, foreach_do, pp_arg, pp_arg_nolist]

    - match: (%)(x?defmacro)(\[)
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
        3: meta.brackets.crc-ir
      push: [macro_body, macro_as, pp_arg_nolist, pp_arg_nolist]

    - match: (%)((?:break|continue|exit(?:macro)?)\d*)\b
      # I don't feel like figuring out how to make these only valid in loops
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir

    # comma
    - match: \,
      scope: punctuation.separator.crc-ir

  arg:
    - match: \]|$
      scope: meta.brackets.crc-ir
      pop: true

  arg_longest:
    - match: \](?=\s*(?:\|.*)?$)
      scope: meta.brackets.crc-ir
      pop: true

    - match: \]
      scope: string.unquoted.crc-ir

  _runtime_arg:
    - include: arg
    - include: variable

    - match: \d+
      scope: constant.numeric.crc-ir

  runtime_arg:
    - include: _runtime_arg

    - match: .
      scope: invalid.illegal.crc-ir

  decl_arg:
    - include: arg
    - include: variable

    - match: \w+
      scope: entity.name.tag.crc-ir

    - match: .
      scope: invalid.illegal.crc-ir

  reg_arg:
    - include: _runtime_arg

    - match: (?<=\[)sp(?=\])
      scope: constant.numeric.crc-ir

    - match: .
      scope: invalid.illegal.crc-ir

  pp_arg:
    - include: arg
    - include: variable

    - match: (?<=\])\[
      scope: meta.brackets.crc-ir

    - match: \,
      scope: punctuation.separator.crc-ir

    - match: '[^$,\]]+'
      scope: string.unquoted.crc-ir

  bracket:
    - match: \[
      scope: meta.brackets.crc-ir
      pop: true

    - match: .
      scope: invalid.illegal.crc-ir

  pp_arg_longest:
    - include: arg_longest
    - include: variable

    - match: \,
      scope: punctuation.separator.crc-ir

    - match: '[^$,\]]+'
      scope: string.unquoted.crc-ir

  pp_arg_nolist:
    - include: nolist
    - include: pp_arg

  if_then:
    - include: comment

    - match: then\b|$
      scope: keyword.operator.word.crc-ir
      pop: true

    - match: \S
      scope: invalid.illegal.crc-ir
  if_body:
    - match: (%)(endif\d*)\b
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
      pop: true

    - match: (%)(else\d*)\b
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
      set: else_body

    - include: main
  else_body:
    - match: (%)(endif\d*)
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
      pop: true

    - include: main

  loop_body:
    - match: (%)(endloop\d*)\b
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
      pop: true

    - include: main

  foreach_do:
    - include: comment

    - match: do\b|$
      scope: keyword.operator.word.crc-ir
      pop: true

    - match: \S
      scope: invalid.illegal.crc-ir
  foreach_body:
    - match: (%)(endfor\d*)\b
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
      pop: true

    - include: main

  macro_as:
    - include: comment

    - match: as\b|$
      scope: keyword.operator.word.crc-ir
      pop: true

    - match: \S
      scope: invalid.illegal.crc-ir
  macro_body:
    - match: (%)(endmacro\d*)\b
      captures:
        1: entity.name.function.crc-ir
        2: keyword.operator.word.crc-ir
      pop: true

    - include: main

  nolist:
    - match: \,
      scope: invalid.illegal.crc-ir

  raw_block:
    - include: arg
    - include: main

  variable:
    - match: (\$)(\w+)
      captures:
        1: punctuation.definition.variable.begin.crc-ir
        2: variable.other.crc-ir

    - match: (#)(\d+)
      captures:
        1: punctuation.definition.variable.begin.crc-ir
        2: variable.other.crc-ir
